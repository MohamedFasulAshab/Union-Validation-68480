@using UnionValidationApp.Client.Models

<p>Renderer: @RendererInfo.Name</p>
<p>Interactive: @RendererInfo.IsInteractive</p>
<p>@Describe()</p>

@code {
    [Parameter]
    public ClassifiedRecordUnion Value { get; set; }

    private string Describe() => Value switch
    {
        ClassifiedCustomerName c => $"CustomerName: {c.Name}",
        ClassifiedProductName p => $"ProductName: {p.Name}",
        null => "null"
    };
}
