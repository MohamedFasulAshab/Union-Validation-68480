@using UnionValidationApp.Client.Models

<p>Renderer: @RendererInfo.Name</p>
<p>Interactive: @RendererInfo.IsInteractive</p>
<p>@Describe()</p>
<button class="btn btn-warning btn-sm" @onclick="Mutate">Mutate</button>

@code {
    [Parameter]
    public NullableIntOrString Value { get; set; }

    private string Describe() => Value switch
    {
        int number => $"int?: {number}",
        string text => $"string: \"{text}\"",
        null => "null (active null case)"
    };

    private void Mutate()
    {
        Value = 888;
    }
}
