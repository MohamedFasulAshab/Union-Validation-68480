@using UnionValidationApp.Client.Models

<div class="card mb-3 shadow-sm border-dark">
    <div class="card-header bg-dark text-white p-1">
        <span class="font-monospace fw-bold small">@Label</span>
    </div>
    <div class="card-body bg-light p-2 font-monospace">
        @if (ActiveUnion is null)
        {
            <span class="text-muted">[Union is Null Reference]</span>
        }
        else
        {
            <!-- Render the computed text output here -->
            <span>@GetUnionDescription()</span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;
    [Parameter, EditorRequired] public ClassifiedRecordUnion ActiveUnion { get; set; }

    // Moving pattern matching safely out of HTML blocks into clean C# methods
    private string GetUnionDescription()
    {
        if (ActiveUnion is null) return "[Null]";

          return ActiveUnion switch
            {
                ClassifiedCustomerName c => $"Active Case: CustomerName | Name: {c.Name}",
                ClassifiedProductName p => $"Active Case: ProductName | Name: {p.Name}",
                 _ => "Unknown classified record union  case pattern matched."
            };
    }
}
